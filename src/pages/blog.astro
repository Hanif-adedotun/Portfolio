---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import blogPosts from "../data/blog-posts.json";
---

<Layout
  title="Writing — Hanif Adedotun"
  description="Essays and technical writing by Hanif Adedotun."
  canonicalUrl="https://hanif.one/blog"
>
  <div class="min-h-screen px-6 pt-8 lg:pt-[18vh] pb-6 max-w-2xl mx-auto">
    <Header />

    <main class="space-y-8 mt-4">
      <section>
        <h1 class="text-lg text-gray-900 dark:text-white mb-6">Writing</h1>

        <div class="mb-6">
          <input
            type="text"
            id="blog-search"
            placeholder="Search…"
            class="w-full max-w-md px-3 py-2 text-base bg-transparent border border-gray-300 rounded-xl dark:border-gray-700 text-gray-900 dark:text-white placeholder-gray-500"
          />
        </div>

        <p id="results-count" class="mb-4 text-sm text-gray-500 hidden">
          <span id="results-text"></span>
        </p>

        <div id="blog-posts-container" class="space-y-8">
          {
            blogPosts.map((post) => (
              <article
                data-title={post.title.toLowerCase()}
                data-author={post.author.toLowerCase()}
                data-intro={post.intro.toLowerCase()}
                class="blog-post border-b border-gray-200 dark:border-gray-800 pb-6 last:border-0"
              >
                <a href={`/blog/${post.slug}`} class="block">
                  <h2 class="text-base text-gray-900 dark:text-white mb-2 underline underline-offset-2 decoration-gray-400 dark:decoration-gray-600">
                    {post.title}
                  </h2>
                  <p class="text-base text-gray-700 dark:text-gray-300 mb-2 line-clamp-2">
                    {post.intro}
                  </p>
                  <p class="text-sm text-gray-500 dark:text-gray-500">
                    {post.author} ·
                    <time datetime={post.date}>
                      {
                        new Date(post.date).toLocaleDateString("en-US", {
                          year: "numeric",
                          month: "long",
                          day: "numeric",
                        })
                      }
                    </time>
                  </p>
                </a>
              </article>
            ))
          }
        </div>

        <div id="no-results" class="hidden py-8">
          <p class="text-gray-600 dark:text-gray-400">No articles found.</p>
        </div>
      </section>
    </main>

    <Footer />
  </div>

  <script is:inline>
    const searchInput = document.getElementById("blog-search");
    const blogPostsContainer = document.getElementById("blog-posts-container");
    const noResults = document.getElementById("no-results");
    const resultsCount = document.getElementById("results-count");
    const resultsText = document.getElementById("results-text");
    const blogPosts = document.querySelectorAll(".blog-post");
    const totalPosts = blogPosts.length;

    function filterPosts(searchTerm) {
      const term = searchTerm.toLowerCase().trim();
      let visibleCount = 0;

      blogPosts.forEach((post) => {
        const title = post.getAttribute("data-title") || "";
        const author = post.getAttribute("data-author") || "";
        const intro = post.getAttribute("data-intro") || "";
        const matches =
          title.includes(term) || author.includes(term) || intro.includes(term);

        if (matches || term === "") {
          post.style.display = "block";
          visibleCount++;
        } else {
          post.style.display = "none";
        }
      });

      if (term === "") {
        resultsCount.classList.add("hidden");
        noResults.classList.add("hidden");
        blogPostsContainer.classList.remove("hidden");
      } else {
        resultsCount.classList.remove("hidden");
        resultsText.textContent = `${visibleCount} of ${totalPosts} found`;
        if (visibleCount === 0) {
          noResults.classList.remove("hidden");
          blogPostsContainer.classList.add("hidden");
        } else {
          noResults.classList.add("hidden");
          blogPostsContainer.classList.remove("hidden");
        }
      }
    }

    let searchTimeout;
    searchInput?.addEventListener("input", (e) => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => filterPosts(e.target.value), 150);
    });
  </script>
</Layout>
