---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WorkEntry from "../components/WorkEntry.astro";
import ProjectStack from "../components/ProjectStack.astro";
import projects from "../data/projects.json";

type Project = {
  name: string[];
  dates: string;
  summary: string;
  banner?: string;
  videoUrl?: string;
  archived?: boolean;
  featured?: boolean;
};

const projectList: Project[] = projects;
const active = projectList.filter((p) => !p.archived);
const archived = projectList.filter((p) => p.archived);
---

<Layout
  title="Work — Hanif Adedotun"
  description="Selected software projects by Hanif Adedotun."
  canonicalUrl="https://hanif.one/projects"
>
  <div class="min-h-screen px-6 pt-10 md:pt-16 lg:pt-[18vh] pb-6 max-w-3xl mx-auto">
    <Header />

    <main class="mt-4">
      <h1 class="text-base md:text-xl font-medium text-gray-900 dark:text-white mb-6 md:mb-10">Some of the projects I've worked on over the years</h1>

      <ProjectStack projects={active} />

      {
        archived.length > 0 && (
          <section class="mt-20">
            <h2 class="text-sm text-gray-500 dark:text-gray-500 mb-10">
              Earlier work
            </h2>
            <div class="space-y-16">
              {
                archived.map((project) => (
                  <WorkEntry
                    title={project.name[0]}
                    url={project.name[1]}
                    dates={project.dates}
                    summary={project.summary}
                    banner={project.banner}
                    videoUrl={project.videoUrl}
                  />
                ))
              }
            </div>
          </section>
        )
      }
    </main>

    <Footer />
  </div>
</Layout>
