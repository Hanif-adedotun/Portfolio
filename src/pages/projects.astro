---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WorkEntry from "../components/WorkEntry.astro";
import projects from "../data/projects.json";

type Project = {
  name: [string, string];
  dates: string;
  summary: string;
  banner?: string;
  archived?: boolean;
};

const projectList = projects as Project[];
const active = projectList.filter((p) => !p.archived);
const archived = projectList.filter((p) => p.archived);
---

<Layout
  title="Work — Hanif Adedotun"
  description="Selected software projects by Hanif Adedotun."
  canonicalUrl="https://hanif.one/projects"
>
  <div class="min-h-screen px-6 pt-10 lg:pt-[18vh] pb-6 max-w-3xl mx-auto">
    <Header />

    <main class="mt-4">
      <h1 class="text-base font-medium text-gray-900 dark:text-white mb-10">Work</h1>

      <div class="space-y-16">
        {
          active.map((project) => (
            <WorkEntry
              title={project.name[0]}
              url={project.name[1]}
              dates={project.dates}
              summary={project.summary}
              banner={project.banner}
            />
          ))
        }
      </div>

      {
        archived.length > 0 && (
          <section class="mt-20">
            <h2 class="text-sm text-gray-500 dark:text-gray-500 mb-10">
              Earlier work
            </h2>
            <div class="space-y-16">
              {
                archived.map((project) => (
                  <WorkEntry
                    title={project.name[0]}
                    url={project.name[1]}
                    dates={project.dates}
                    summary={project.summary}
                    banner={project.banner}
                  />
                ))
              }
            </div>
          </section>
        )
      }
    </main>

    <Footer />
  </div>
</Layout>
