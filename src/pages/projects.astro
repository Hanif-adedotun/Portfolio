---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Icon } from "astro-icon/components";
import projects from "../data/projects.json";

type Project = {
  img?: string;
  name: [string, string];
  summary: string;
  tools: string[];
  banner?: string;
  videoUrl?: string;
  notMaintained?: boolean;
};

const projectList = projects as Project[];

const toYouTubeEmbed = (url?: string) => {
  if (!url) return "";
  const trimmed = url.trim();
  const match =
    trimmed.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([\w-]{11})/) ||
    trimmed.match(/youtube\.com\/embed\/([\w-]{11})/);
  if (!match) return "";
  return `https://www.youtube.com/embed/${match[1]}?autoplay=1&mute=1&rel=0&modestbranding=1`;
};
---

<Layout 
  title="Projects - Hanif Adedotun"
  description="Portfolio of software projects by Hanif Adedotun, featuring web applications and development work."
  canonicalUrl="https://hanif.one/projects"
>
  <style is:global>
    @keyframes project-preview-popover-in {
      from {
        opacity: 0;
        transform: translateY(8px) scale(0.97);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
    #project-preview-popover:not(.hidden) {
      animation: project-preview-popover-in 240ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @media (prefers-reduced-motion: reduce) {
      #project-preview-popover:not(.hidden) {
        animation: none;
      }
    }
  </style>

  <div class="min-h-screen p-6 max-w-4xl mx-auto">
    <Header />

    <main class="space-y-12 mt-8">
      <section class="animate-fade-in-up">
        <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-8">
          Projects
        </h1>
        <div class="space-y-8 grid grid-cols-1 md:grid-cols-2 gap-4">
          {projectList.map((project, index) => {
            const bannerSrc = project.banner?.trim();
            const embedUrl = toYouTubeEmbed(project.videoUrl);
            const hasPreview = Boolean(bannerSrc || embedUrl);

            return (
            <article 
              class="border border-gray-200 dark:border-gray-800 rounded-2xl p-6 last:border-gray-200 dark:last:border-gray-800 transition-all duration-300 hover:translate-x-1 hover:border-contrast/40 group bg-white/70 dark:bg-gray-900/40"
              style={`animation: fadeInUp 0.5s ease-out ${index * 100}ms both`}
            >
              <div class="flex items-start justify-between gap-4 mb-4">
                <h2 class="flex flex-wrap items-center gap-2 text-2xl font-semibold text-gray-900 dark:text-white group-hover:text-contrast transition-colors duration-300">
                  <a
                  href={project.name[1]}
                  target="_blank"
                  rel="noopener noreferrer">{project.name[0]}</a>
                  {project.notMaintained ? (
                    <span
                      class="inline-flex items-center rounded-sm border border-amber-200 bg-amber-50 px-2 py-0.5 text-[7px] font-semibold  tracking-wide text-amber-900 dark:border-amber-800/80 dark:bg-amber-950/50 dark:text-amber-200"
                      title="This project is no longer actively maintained"
                    >
                      Not maintained
                    </span>
                  ) : null}
                </h2>
                <a
                  href={project.name[1]}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-gray-500 dark:text-gray-400 hover:text-contrast transition-all duration-300 hover:scale-110 shrink-0"
                  aria-label={`Visit ${project.name[0]}`}
                >
                  <Icon name="mdi:web" class="w-5 h-5" />
                </a>
              </div>
              <p class="text-base text-gray-600 dark:text-gray-400 mb-4 leading-relaxed group-hover:text-gray-700 dark:group-hover:text-gray-300 transition-colors duration-300">
                {project.summary}
              </p>

              <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-wrap gap-2">
                  {project.tools.map((tool: string, toolIndex: number) => (
                    <span 
                      class="text-sm px-3 py-1 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 border border-gray-200 dark:border-gray-700 transition-all duration-300 hover:scale-105 hover:bg-gray-200 dark:hover:bg-gray-700 hover:border-contrast"
                      style={`animation: scaleIn 0.3s ease-out ${(index * 100) + (toolIndex * 50) + 200}ms both`}
                    >
                      {tool}
                    </span>
                  ))}
                </div>
              </div>
              <div class="mt-4">
                {hasPreview ? (
                  <>
                    <button
                      type="button"
                      class="preview-trigger md:hidden inline-flex items-center gap-2 text-sm px-3 py-2 border border-gray-200 dark:border-gray-700 rounded-lg bg-transparent text-white dark:text-white hover:opacity-90 transition-opacity"
                      data-project-title={project.name[0]}
                      data-banner-src={bannerSrc ?? ""}
                      data-video-src={embedUrl}
                      aria-label={`Preview ${project.name[0]} media`}
                    >
                      <Icon name="mdi:play-circle-outline" class="w-4 h-4" />
                      Preview
                    </button>

                    <button
                      type="button"
                      class="preview-hover-trigger hidden md:inline-flex items-center gap-2 text-sm px-3 py-2 border border-gray-200 dark:border-gray-700 rounded-lg bg-transparent text-white dark:text-white hover:opacity-90 transition-opacity"
                      data-project-title={project.name[0]}
                      data-banner-src={bannerSrc ?? ""}
                      data-video-src={embedUrl}
                      aria-label={`Hover to preview ${project.name[0]} media`}
                    >
                      <Icon name="mdi:motion-play-outline" class="w-4 h-4" />
                      Hover to preview
                    </button>
                  </>
                ) : (
                  null
                )}
              </div>
            </article>
          );
          })}
        </div>
      </section>
    </main>

    <Footer />
  </div>

  <div
    id="project-preview-popover"
    class="fixed z-40 hidden w-[min(22rem,92vw)] md:w-[40vw] md:min-w-[12rem] md:max-w-[min(40vw,92vw)] overflow-hidden rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-2xl origin-top will-change-transform"
    role="status"
    aria-live="polite"
  >
    <div id="project-preview-popover-body" class="aspect-video bg-gray-100 dark:bg-gray-950"></div>
    <div id="project-preview-popover-title" class="px-3 py-2 text-sm text-gray-700 dark:text-gray-300 border-t border-gray-200 dark:border-gray-800"></div>
  </div>

  <div
    id="project-preview-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="project-preview-title"
  >
    <div class="w-full max-w-3xl rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 overflow-hidden shadow-2xl">
      <div class="flex items-center justify-between px-4 py-3 border-b border-gray-200 dark:border-gray-800">
        <h3 id="project-preview-title" class="text-lg font-semibold text-gray-900 dark:text-white">
          Project preview
        </h3>
        <button
          type="button"
          id="project-preview-close"
          class="p-2 rounded-md text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
          aria-label="Close project preview"
        >
          <Icon name="mdi:close" class="w-5 h-5" />
        </button>
      </div>
      <div id="project-preview-body" class="aspect-video bg-gray-100 dark:bg-gray-950 flex items-center justify-center">
        <p class="text-sm text-gray-500 dark:text-gray-400">No preview loaded</p>
      </div>
    </div>
  </div>

  <script>
    const modal = document.getElementById("project-preview-modal");
    const modalBody = document.getElementById("project-preview-body");
    const modalTitle = document.getElementById("project-preview-title");
    const closeButton = document.getElementById("project-preview-close");
    const mobileTriggers = document.querySelectorAll<HTMLButtonElement>(".preview-trigger");
    const desktopTriggers = document.querySelectorAll<HTMLButtonElement>(".preview-hover-trigger");
    const popover = document.getElementById("project-preview-popover");
    const popoverBody = document.getElementById("project-preview-popover-body");
    const popoverTitle = document.getElementById("project-preview-popover-title");

    if (modal && modalBody && modalTitle && closeButton && popover && popoverBody && popoverTitle) {
      let popoverHideTimer: ReturnType<typeof setTimeout> | null = null;
      let popoverVideoTimer: ReturnType<typeof setTimeout> | null = null;

      const VIDEO_SWAP_MS = 150;

      const createBannerMarkup = (title: string, bannerSrc: string) =>
        `<img
          src="${bannerSrc}"
          alt="${title} banner"
          class="h-full w-full object-cover"
          loading="lazy"
        />`;

      const createVideoMarkup = (title: string, videoSrc: string) =>
        `<iframe
          src="${videoSrc}"
          title="${title} video preview"
          class="h-full w-full"
          loading="lazy"
          allow="autoplay; encrypted-media; picture-in-picture"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>`;

      const createPlaceholderMarkup = () =>
        `<div class="h-full w-full flex items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200 dark:from-gray-800 dark:to-gray-900" aria-hidden="true">
          <span class="inline-block h-8 w-8 rounded-full border-2 border-gray-300 border-t-contrast dark:border-gray-600 dark:border-t-contrast animate-spin [animation-duration:900ms]"></span>
        </div>`;

      const createPreviewMarkup = (title: string, bannerSrc: string, videoSrc: string) => {
        if (videoSrc) return createVideoMarkup(title, videoSrc);
        return createBannerMarkup(title, bannerSrc);
      };

      const closeModal = () => {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        modalBody.innerHTML =
          '<p class="text-sm text-gray-500 dark:text-gray-400">No preview loaded</p>';
      };

      const clearPopoverVideoTimer = () => {
        if (popoverVideoTimer) {
          clearTimeout(popoverVideoTimer);
          popoverVideoTimer = null;
        }
      };

      const hidePopover = () => {
        clearPopoverVideoTimer();
        popover.classList.add("hidden");
        popoverBody.innerHTML = "";
      };

      const schedulePopoverHide = () => {
        if (popoverHideTimer) clearTimeout(popoverHideTimer);
        popoverHideTimer = setTimeout(hidePopover, 120);
      };

      const showPopover = (button: HTMLButtonElement) => {
        const title = button.getAttribute("data-project-title") ?? "Project preview";
        const bannerSrc = button.getAttribute("data-banner-src") ?? "";
        const videoSrc = button.getAttribute("data-video-src") ?? "";
        if (!bannerSrc && !videoSrc) return;

        if (popoverHideTimer) clearTimeout(popoverHideTimer);
        clearPopoverVideoTimer();

        popoverTitle.textContent = title;

        const hasVideo = Boolean(videoSrc);
        const hasBanner = Boolean(bannerSrc);

        if (hasVideo && hasBanner) {
          popoverBody.innerHTML = createBannerMarkup(title, bannerSrc);
          popoverVideoTimer = setTimeout(() => {
            popoverBody.innerHTML = createVideoMarkup(title, videoSrc);
            popoverVideoTimer = null;
          }, VIDEO_SWAP_MS);
        } else if (hasVideo && !hasBanner) {
          popoverBody.innerHTML = createPlaceholderMarkup();
          popoverVideoTimer = setTimeout(() => {
            popoverBody.innerHTML = createVideoMarkup(title, videoSrc);
            popoverVideoTimer = null;
          }, VIDEO_SWAP_MS);
        } else {
          popoverBody.innerHTML = createBannerMarkup(title, bannerSrc);
        }

        popover.classList.remove("hidden");

        const rect = button.getBoundingClientRect();
        const placePopover = () => {
          const popW = popover.offsetWidth;
          const popH = popover.offsetHeight;
          const top = Math.min(
            window.innerHeight - popH - 12,
            Math.max(12, rect.bottom + 12)
          );
          const centerX = rect.left + rect.width / 2 - popW / 2;
          const left = Math.min(
            window.innerWidth - popW - 12,
            Math.max(12, centerX)
          );
          popover.style.top = `${top}px`;
          popover.style.left = `${left}px`;
        };

        requestAnimationFrame(() => {
          placePopover();
          requestAnimationFrame(placePopover);
        });
      };

      mobileTriggers.forEach((button) => {
        button.addEventListener("click", () => {
          if (!window.matchMedia("(max-width: 767px)").matches) return;

          const title = button.getAttribute("data-project-title") ?? "Project preview";
          const bannerSrc = button.getAttribute("data-banner-src") ?? "";
          const videoSrc = button.getAttribute("data-video-src") ?? "";

          if (!bannerSrc && !videoSrc) return;

          modalTitle.textContent = title;
          modalBody.innerHTML = createPreviewMarkup(title, bannerSrc, videoSrc);

          modal.classList.remove("hidden");
          modal.classList.add("flex");
        });
      });

      desktopTriggers.forEach((button) => {
        button.addEventListener("mouseenter", () => showPopover(button));
        button.addEventListener("mouseleave", schedulePopoverHide);
        button.addEventListener("focus", () => showPopover(button));
        button.addEventListener("blur", schedulePopoverHide);
      });

      popover.addEventListener("mouseenter", () => {
        if (popoverHideTimer) clearTimeout(popoverHideTimer);
      });
      popover.addEventListener("mouseleave", schedulePopoverHide);

      closeButton.addEventListener("click", closeModal);

      modal.addEventListener("click", (event) => {
        if (event.target === modal) closeModal();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !modal.classList.contains("hidden")) {
          closeModal();
        }

        if (event.key === "Escape" && !popover.classList.contains("hidden")) {
          hidePopover();
        }
      });

      window.addEventListener("scroll", hidePopover, true);
      window.addEventListener("resize", hidePopover);
    }
  </script>
</Layout>