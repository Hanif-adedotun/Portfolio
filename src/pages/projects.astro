---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import projects from "../data/projects.json";

type Project = {
  name: [string, string];
  summary: string;
  archived?: boolean;
};

const projectList = projects as Project[];
const active = projectList.filter((p) => !p.archived);
const archived = projectList.filter((p) => p.archived);
---

<Layout
  title="Work — Hanif Adedotun"
  description="Selected software projects by Hanif Adedotun."
  canonicalUrl="https://hanif.one/projects"
>
  <div class="min-h-screen p-6 max-w-2xl mx-auto">
    <Header />

    <main class="space-y-10 mt-4">
      <section>
        <h1 class="text-lg text-gray-900 dark:text-white mb-6">Work</h1>
        <div class="space-y-8">
          {
            active.map((project) => (
              <div>
                <p class="text-base text-gray-900 dark:text-white">
                  <a
                    href={project.name[1]}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline underline-offset-2 decoration-gray-400 dark:decoration-gray-600"
                  >
                    {project.name[0]}
                  </a>
                </p>
                <p class="mt-1 text-base text-gray-700 dark:text-gray-300">
                  {project.summary}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      {
        archived.length > 0 && (
          <section>
            <h2 class="text-base text-gray-500 dark:text-gray-500 mb-4">
              Earlier work
            </h2>
            <div class="space-y-6">
              {
                archived.map((project) => (
                  <div>
                    <p class="text-base text-gray-900 dark:text-white">
                      <a
                        href={project.name[1]}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="underline underline-offset-2 decoration-gray-400 dark:decoration-gray-600"
                      >
                        {project.name[0]}
                      </a>
                    </p>
                    <p class="mt-1 text-base text-gray-700 dark:text-gray-300">
                      {project.summary}
                    </p>
                  </div>
                ))
              }
            </div>
          </section>
        )
      }
    </main>

    <Footer />
  </div>
</Layout>
