---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import BlogPostContent from "../../components/BlogPostContent.astro";
import blogPosts from "../../data/blog-posts.json";

export async function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const site = Astro.site || "https://hanif.one";
const postUrl = new URL(`/blog/${post.slug}`, site).href;
const postDate = new Date(post.date).toISOString();
---

<Layout
  title={`${post.title} — Hanif Adedotun`}
  description={post.intro || `Read ${post.title} by Hanif Adedotun`}
  canonicalUrl={postUrl}
  type="article"
  author={post.author}
  publishedTime={postDate}
  section="Technology"
>
  <div class="min-h-screen p-6 max-w-4xl mx-auto">
    <a
      href="/blog"
      class="inline-block text-sm text-gray-500 dark:text-gray-500 mb-8 underline underline-offset-2 decoration-gray-400 dark:decoration-gray-600"
    >
      ← Writing
    </a>

    <div class="flex gap-12">
      <BlogPostContent post={post} />

      <aside class="hidden lg:block w-48 shrink-0">
        <nav class="sticky top-8" aria-label="Table of contents">
          <p class="text-sm text-gray-500 dark:text-gray-500 mb-3">Contents</p>
          <ul class="space-y-2 text-sm">
            {
              post.sections.map((section) => (
                <li>
                  <a
                    href={`#${section.id}`}
                    class="text-gray-600 dark:text-gray-400 underline underline-offset-2 decoration-gray-400 dark:decoration-gray-600"
                  >
                    {section.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>
    </div>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": post.title,
      "description": post.intro || "",
      "author": {
        "@type": "Person",
        "name": post.author,
        "url": site
      },
      "datePublished": postDate,
      "dateModified": postDate,
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": postUrl
      },
      "url": postUrl
    })} />

    <Footer />
  </div>
</Layout>

<style>
  section[id] {
    scroll-margin-top: 2rem;
  }
</style>
