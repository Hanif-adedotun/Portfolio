---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const resumeUrl =
  "https://docs.google.com/document/d/1sC0lsScDSwPbR-SpXfl6cY_rcB67E4sgOdKBeQMlWqc/edit?usp=sharing";
const academicCvUrl =
  "https://docs.google.com/document/d/1KSpU9eojLUHrX8ETWiE388v2JlEBDXPFipkClBi-ivc/edit?usp=sharing";
---

<Layout
  title="CV — Hanif Adedotun"
  description="Resume and academic CV of Hanif Adedotun."
  canonicalUrl="https://hanif.one/cv"
>
  <div class="min-h-screen p-6 max-w-2xl mx-auto">
    <Header />

    <main class="mt-4">
      <section>
        <h1 class="text-lg text-gray-900 dark:text-white mb-6">CV</h1>
        <div class="space-y-3 text-base">
          <p>
            <a
              href={resumeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="underline underline-offset-2 decoration-gray-400 dark:decoration-gray-600"
            >
              Resume
            </a>
          </p>
          <p>
            <a
              href={academicCvUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="underline underline-offset-2 decoration-gray-400 dark:decoration-gray-600"
            >
              Academic CV
            </a>
          </p>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>
