---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import projects from "../data/projects.json";
import about from "../data/about.json";
import blogPosts from "../data/blog-posts.json";

const featuredProjects = projects.filter((p) => p.featured);
---

<Layout
  title="Hanif Adedotun"
  description={about.summary}
  canonicalUrl="https://hanif.one/"
>
  <div class="min-h-screen p-6 max-w-2xl mx-auto">
    <Header />

    <main class="space-y-12">
      <section>
        <p class="text-base leading-relaxed text-gray-700 dark:text-gray-300">
          {about.summary}
        </p>
        <p class="mt-4 text-sm">
          <a
            href="/cv"
            class="underline underline-offset-2 decoration-gray-400 dark:decoration-gray-600"
          >
            CV
          </a>
        </p>
      </section>

      <section>
        <h2 class="text-lg text-gray-900 dark:text-white mb-6">Selected work</h2>
        <div class="space-y-6">
          {
            featuredProjects.map((project) => (
              <div>
                <p class="text-base text-gray-900 dark:text-white">
                  <a
                    href={project.name[1]}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline underline-offset-2 decoration-gray-400 dark:decoration-gray-600"
                  >
                    {project.name[0]}
                  </a>
                  {project.archived && (
                    <span class="text-sm text-gray-500 dark:text-gray-500">
                      {" "}
                      (archived)
                    </span>
                  )}
                </p>
                <p class="mt-1 text-base text-gray-700 dark:text-gray-300">
                  {project.summary}
                </p>
              </div>
            ))
          }
        </div>
        <p class="mt-4 text-sm">
          <a
            href="/projects"
            class="underline underline-offset-2 decoration-gray-400 dark:decoration-gray-600"
          >
            All work
          </a>
        </p>
      </section>

      <section>
        <h2 class="text-lg text-gray-900 dark:text-white mb-6">Writing</h2>
        <div class="space-y-3">
          {
            blogPosts.slice(0, 5).map((post) => (
              <div class="flex flex-col sm:flex-row sm:gap-6 text-base">
                <span class="text-sm text-gray-500 dark:text-gray-500 shrink-0 sm:w-28">
                  {
                    new Date(post.date).toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                    })
                  }
                </span>
                <a
                  href={`/blog/${post.slug}`}
                  class="text-gray-700 dark:text-gray-300 underline underline-offset-2 decoration-gray-400 dark:decoration-gray-600"
                >
                  {post.title}
                </a>
              </div>
            ))
          }
        </div>
        <p class="mt-4 text-sm">
          <a
            href="/blog"
            class="underline underline-offset-2 decoration-gray-400 dark:decoration-gray-600"
          >
            All writing
          </a>
        </p>
      </section>
    </main>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Hanif Adedotun",
      "url": "https://hanif.one",
      "email": "hey@hanif.one",
      "jobTitle": "Lead Software Engineer",
      "sameAs": [
        "https://github.com/hanif-adedotun",
        "https://x.com/@devhanif",
        "https://linkedin.com/in/hanif-adedotun"
      ]
    })} />

    <Footer />
  </div>
</Layout>
