---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Intro from "../components/Intro.astro";
import Footer from "../components/Footer.astro";
import WorkEntry from "../components/WorkEntry.astro";
import WhySection from "../components/WhySection.astro";
import projects from "../data/projects.json";
import about from "../data/about.json";
import blogPosts from "../data/blog-posts.json";

const featuredProjects = projects.filter((p) => p.featured);

const description = `${about.intro.beforeCompany} ${about.company}${about.intro.afterCompany} ${about.intro.neurosync}${about.intro.afterNeurosync} ${about.intro.hiro}${about.intro.end}`;
---

<Layout
  title="Hanif Adedotun"
  description={description}
  canonicalUrl="https://hanif.one/"
>
  <div class="min-h-screen px-6 pt-10 lg:pt-[18vh] pb-6 max-w-3xl mx-auto">
    <Header />
    <Intro />

    <main class="space-y-16">
      <section>
        <h2 class="text-xl font-medium text-gray-900 dark:text-white mb-10">
          Some of my work
        </h2>
        <div class="space-y-16">
          {
            featuredProjects.slice(0, 3).map((project) => (
              <WorkEntry
                title={project.name[0]}
                url={project.name[1]}
                dates={project.dates}
                summary={project.summary}
                banner={project.banner}
                videoUrl={project.videoUrl}
              />
            ))
          }
           <p class="mt-10 text-center">
            <a
              href="/projects"
              class="underline underline-offset-2 decoration-gray-400 dark:decoration-gray-600"
            >
              See more projects 
            </a>
          </p>
        </div>
        <WhySection />
       
      </section>

      <!-- <section>
        <h2 class="text-base font-medium text-gray-900 dark:text-white mb-6">
          Writing
        </h2>
        <div class="space-y-3">
          {
            blogPosts.slice(0, 5).map((post) => (
              <div class="flex flex-col sm:flex-row sm:gap-6">
                <span class="text-sm shrink-0 sm:w-28">
                  {
                    new Date(post.date).toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                    })
                  }
                </span>
                <a
                  href={`/blog/${post.slug}`}
                  class="underline underline-offset-2 decoration-gray-400 dark:decoration-gray-600"
                >
                  {post.title}
                </a>
              </div>
            ))
          }
        </div>
        <p class="mt-6">
          <a
            href="/blog"
            class="underline underline-offset-2 decoration-gray-400 dark:decoration-gray-600"
          >
            All writing
          </a>
        </p>
      </section> -->
    </main>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Hanif Adedotun",
      "url": "https://hanif.one",
      "email": "hey@hanif.one",
      "jobTitle": "Software Engineer",
      "sameAs": [
        "https://github.com/hanif-adedotun",
        "https://x.com/@devhanif",
        "https://linkedin.com/in/hanif-adedotun"
      ]
    })} />

    <Footer />
  </div>
</Layout>
