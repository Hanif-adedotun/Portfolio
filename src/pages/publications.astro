---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import publications from "../data/publications.json";
---

<Layout
  title="Papers — Hanif Adedotun"
  description="Research publications by Hanif Adedotun."
  canonicalUrl="https://hanif.one/publications"
>
  <div class="min-h-screen px-6 pt-10 md:pt-16 lg:pt-[18vh] pb-6 max-w-2xl mx-auto">
    <Header />

    <main class="space-y-8 mt-4">
      <section>
        <h1 class="text-lg text-gray-900 dark:text-white mb-4">Publications</h1>
        <p class="text-sm mb-6">
          <a
            href="https://scholar.google.com/citations?user=FpK8icMAAAAJ&hl=en"
            target="_blank"
            rel="noopener noreferrer"
            class="underline underline-offset-2 decoration-gray-400 dark:decoration-gray-600"
          >
            Google Scholar
          </a>
        </p>

        <div class="space-y-8">
          {
            publications.map((publication) => (
              <article>
                <h2 class="text-base text-gray-900 dark:text-white mb-2 leading-snug">
                  {
                    publication.link ? (
                      <a
                        href={publication.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="underline underline-offset-2 decoration-gray-400 dark:decoration-gray-600"
                      >
                        {publication.title}
                      </a>
                    ) : (
                      publication.title
                    )
                  }
                </h2>
                <p class="text-sm text-gray-500 dark:text-gray-500 mb-2">
                  {publication.authors.join(", ")}
                </p>
                <p class="text-sm text-gray-500 dark:text-gray-500 mb-3">
                  {publication.venue} · {publication.year}
                </p>
                {
                  publication.description && (
                    <p class="text-base text-gray-700 dark:text-gray-300 leading-relaxed">
                      {publication.description}
                    </p>
                  )
                }
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>
