---
import { Signature } from "./handwriting";

const currentYear = new Date().getFullYear();
const version = "3.1.1";
---

<footer class="mt-16 pt-8 flex flex-col gap-4 sm:flex-row sm:justify-between sm:items-center sm:gap-0 border-t border-gray-200 dark:border-gray-800 text-sm text-gray-500">

  <p>© {currentYear} Hanif Adedotun</p>
  <p>v {version}</p>

  <div class="flex">
    <Signature signature="hanif" inline client:load className="!text-gray-500 h-[2.5em]"/>
  </div>
</footer>
