---
import { Signature } from "./handwriting";

const currentYear = new Date().getFullYear();
const version = "3.1.1";
---

<footer class="mt-16 pt-8 flex justify-between items-center border-t border-gray-200 dark:border-gray-800 text-sm text-gray-500 text-center">

  <p class="mb-2">© {currentYear} Hanif Adedotun</p>
  <p>
    v {version}
  </p>

  <div class="flex justify-center">
    <Signature signature="hanif" inline client:load className="!text-gray-500 h-[2.5em]"/>
  </div>
</footer>
