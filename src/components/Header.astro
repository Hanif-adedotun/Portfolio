---
import Navbar from "./Navbar.astro";
import PulseAvatar from "./PulseAvatar";
import about from "../data/about.json";
---

<header class="mb-10">
  <div class="mb-10">
    <Navbar />
  </div>

  <div class="flex items-center gap-4">
    <PulseAvatar src="/logo.png" alt={about.name} client:load />
    <div class="min-w-0">
      <h1 class="text-base font-medium text-gray-900 dark:text-white leading-tight">
        {about.name}
      </h1>
      <p class="leading-tight">{about.title}</p>
    </div>
  </div>
</header>
