---
import Navbar from "./Navbar.astro";
import PulseAvatar from "./PulseAvatar";
import about from "../data/about.json";
---

<header class="mb-10">
  <!-- Renders mobile pill nav (lg:hidden) + desktop arc nav inline -->
  <Navbar />

  <!-- Spacer only visible on mobile, between nav and avatar -->
  <div class="mb-8 lg:hidden" aria-hidden="true"></div>

  <div class="flex items-center gap-4">
    <PulseAvatar src="/logo.png" alt={about.name} client:load />
    <div class="min-w-0">
      <h1 class="text-base font-medium text-gray-900 dark:text-white leading-tight">
        {about.name}
      </h1>
      <p class="leading-tight">{about.title}</p>
    </div>
  </div>
</header>
