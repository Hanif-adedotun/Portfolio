---
const currentPath = Astro.url.pathname;

const navItems = [
  { name: "Home", path: "/" },
  { name: "Writing", path: "/blog" },
  { name: "Work", path: "/projects" },
  { name: "Papers", path: "/publications" },
  { name: "CV", path: "/cv" },
];

const activePath =
  currentPath === "/"
    ? "/"
    : navItems.find((item) => item.path !== "/" && currentPath.startsWith(item.path))
        ?.path ?? "/";
---

<nav aria-label="Primary">
  <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
    {
      navItems.map((item) => {
        const isActive = activePath === item.path;
        return (
          <li>
            <a
              href={item.path}
              class:list={[
                isActive
                  ? "text-gray-900 dark:text-white"
                  : "text-gray-500 dark:text-gray-500 underline underline-offset-2 decoration-gray-400 dark:decoration-gray-600",
              ]}
              aria-current={isActive ? "page" : undefined}
            >
              {item.name}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
