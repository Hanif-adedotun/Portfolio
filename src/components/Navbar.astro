---
const currentPath = Astro.url.pathname;

const navItems = [
  { name: "Home", path: "/" },
  { name: "Writing", path: "/blog" },
  { name: "Work", path: "/projects" },
  { name: "Papers", path: "/publications" },
  { name: "CV", path: "/cv" },
];

const activePath =
  currentPath === "/"
    ? "/"
    : navItems.find((item) => item.path !== "/" && currentPath.startsWith(item.path))
        ?.path ?? "/";
---

<!-- Mobile / tablet nav -->
<nav aria-label="Primary" class="lg:hidden">
  <div class="flex w-full items-center gap-0.5 p-1 bg-white/70 dark:bg-white/[0.04] backdrop-blur border border-gray-200/80 dark:border-white/[0.08] rounded-full shadow-sm shadow-gray-200/60 dark:shadow-none">
    {navItems.map((item) => {
      const isActive = activePath === item.path;
      return (
        <a
          href={item.path}
          aria-current={isActive ? "page" : undefined}
          class:list={[
            "nav-pill flex-1 min-w-0 text-center px-2 sm:px-3 md:px-4 py-1.5 md:py-2 text-[11px] sm:text-xs md:text-sm font-medium rounded-full whitespace-nowrap select-none",
            isActive
              ? "is-active bg-gray-900 dark:bg-white text-white dark:text-gray-900 shadow-sm"
              : "text-gray-500 dark:text-gray-400",
          ]}
        >
          {item.name}
        </a>
      );
    })}
  </div>
</nav>

<!-- Desktop nav — fixed left, centered vertically -->
<nav aria-label="Primary" class="hidden lg:block fixed left-7 xl:left-10 2xl:left-16 top-1/2 -translate-y-1/2 z-50">
  <div class="flex flex-col gap-6">
    {navItems.map((item) => {
      const isActive = activePath === item.path;
      return (
        <a
          href={item.path}
          aria-current={isActive ? "page" : undefined}
          class:list={[
            "nav-desktop group flex items-center gap-3",
            isActive && "is-active",
          ]}
        >
          <!-- Notch dot -->
          <div
            class:list={[
              "nav-dot relative z-10 w-3 h-3 shrink-0 rounded-full border-2",
              isActive
                ? "bg-gray-900 dark:bg-white border-gray-900 dark:border-white scale-110"
                : "bg-[#F8F9FC] dark:bg-[#0D1117] border-gray-300 dark:border-gray-600",
            ]}
          />
          <!-- Label -->
          <span
            class:list={[
              "nav-label text-[11px] tracking-wide leading-none whitespace-nowrap",
              isActive
                ? "text-gray-900 dark:text-white font-medium"
                : "text-gray-400 dark:text-gray-500",
            ]}
          >
            {item.name}
          </span>
        </a>
      );
    })}
  </div>
</nav>

<style>
  .nav-pill {
    transition:
      color 150ms ease,
      background-color 150ms ease,
      box-shadow 150ms ease,
      transform 160ms var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1));
  }

  .nav-desktop {
    transition: transform 160ms var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1));
  }

  .nav-dot {
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease,
      transform 200ms var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1));
  }

  .nav-label {
    transition: color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-pill:not(.is-active):hover {
      color: #1f2937; /* gray-800 */
    }

    :global(.dark) .nav-pill:not(.is-active):hover {
      color: #e5e7eb; /* gray-200 */
    }

    .nav-desktop:hover,
    .nav-desktop:focus-visible {
      transform: translateX(0.375rem); /* translate-x-1.5 */
    }

    .nav-desktop:not(.is-active):hover .nav-dot {
      border-color: #6b7280; /* gray-500 */
    }

    :global(.dark) .nav-desktop:not(.is-active):hover .nav-dot {
      border-color: #9ca3af; /* gray-400 */
    }

    .nav-desktop:not(.is-active):hover .nav-label {
      color: #374151; /* gray-700 */
    }

    :global(.dark) .nav-desktop:not(.is-active):hover .nav-label {
      color: #d1d5db; /* gray-300 */
    }
  }

  /* Press feedback after hover so :active wins when both apply */
  .nav-pill:active,
  .nav-desktop:active {
    transform: scale(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-pill,
    .nav-desktop,
    .nav-dot,
    .nav-label {
      transition: none;
    }

    .nav-pill:active,
    .nav-desktop:active,
    .nav-desktop:hover,
    .nav-desktop:focus-visible {
      transform: none;
    }
  }
</style>
