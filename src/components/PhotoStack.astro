---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import photos from "../data/photos.json";

type Photo = {
  src: string;
  alt: string;
  caption: string;
  description: string;
  link?: { label: string; url: string };
};

/*
  photos.json keeps paths like "/assets/pics/njit.jpeg"; the files live in
  src/assets/pics so Astro can resize and re-encode them at build time.
*/
const sources = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/pics/*.{jpg,jpeg,png,webp}",
  { eager: true },
);

// Inner width of a polaroid's square frame (300px card − 2×14px padding).
const FRAME = 272;
// Positions 0–3 peek out of the stack; anything deeper is fully hidden.
const VISIBLE_DEPTH = 4;

const FORMATS = [
  { format: "avif", type: "image/avif", quality: 50 },
  { format: "webp", type: "image/webp", quality: 70 },
] as const;

async function srcsetFor(
  image: ImageMetadata,
  widths: number[],
  format: "avif" | "webp" | "jpg",
  quality: number,
) {
  const urls = await Promise.all(
    widths.map((width) => getImage({ src: image, width, format, quality })),
  );
  return urls.map((url, i) => `${url.src} ${i + 1}x`).join(", ");
}

const items = await Promise.all(
  (photos as Photo[]).map(async (photo) => {
    const image = sources[`/src${photo.src}`]?.default;
    if (!image) {
      throw new Error(
        `PhotoStack: "${photo.src}" not found. Put the file in src/assets/pics/.`,
      );
    }

    // The frame is square with object-fit: cover, so the *short* side has to
    // cover FRAME at each density — landscape shots need extra width.
    const aspect = Math.max(1, image.width / image.height);
    const widths = [1, 2].map((density) =>
      Math.min(image.width, Math.ceil(FRAME * density * aspect)),
    );

    const [fallback, ...modern] = await Promise.all([
      srcsetFor(image, widths, "jpg", 72),
      ...FORMATS.map(({ format, quality }) =>
        srcsetFor(image, widths, format, quality),
      ),
    ]);

    return {
      ...photo,
      width: widths[0],
      height: Math.round(widths[0] / (image.width / image.height)),
      fallback,
      fallbackSrc: fallback.split(" ")[0],
      modern: modern.map((srcset, i) => ({ srcset, type: FORMATS[i].type })),
    };
  }),
);

const total = items.length;
---

{
  total > 0 && (
    <section
      class="photo-carousel mb-16"
      role="region"
      aria-roledescription="carousel"
      aria-label="Photos from my work"
      tabindex="0"
    >
      {/*
        Every polaroid shares one grid cell; data-position (0 = front)
        drives the offset/tilt, so the stack reshuffles via CSS transitions.
      */}
      <div class="photo-stack">
        {items.map((photo, index) => (
          <figure
            class="photo-slide"
            data-position={index}
            role="group"
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${total}`}
            aria-hidden={index === 0 ? "false" : "true"}
            inert={index !== 0}
          >
            <div class="photo-frame">
              {index < VISIBLE_DEPTH ? (
                <picture>
                  {photo.modern.map((source) => (
                    <source type={source.type} srcset={source.srcset} />
                  ))}
                  <img
                    src={photo.fallbackSrc}
                    srcset={photo.fallback}
                    width={photo.width}
                    height={photo.height}
                    alt={photo.alt}
                    draggable="false"
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "low"}
                    decoding="async"
                  />
                </picture>
              ) : (
                /* Buried cards hold their URLs in data-* until they near the front. */
                <picture data-deferred>
                  {photo.modern.map((source) => (
                    <source type={source.type} data-srcset={source.srcset} />
                  ))}
                  <img
                    data-src={photo.fallbackSrc}
                    data-srcset={photo.fallback}
                    width={photo.width}
                    height={photo.height}
                    alt={photo.alt}
                    draggable="false"
                    decoding="async"
                  />
                </picture>
              )}
            </div>
            <figcaption>{photo.caption}</figcaption>
          </figure>
        ))}
      </div>

      {total > 1 && (
        <div class="photo-controls">
          <button
            type="button"
            class="photo-arrow"
            data-photo-prev
            data-cuelume-press="press"
            data-cuelume-release="release"
            aria-label="Previous photo"
          >
            ←
          </button>
          <span class="photo-count" aria-live="polite" aria-atomic="true">
            1 / {total}
          </span>
          <button
            type="button"
            class="photo-arrow"
            data-photo-next
            data-cuelume-press="press"
            data-cuelume-release="release"
            aria-label="Next photo"
          >
            →
          </button>
        </div>
      )}

      <div class="photo-descriptions" aria-live="polite" aria-atomic="true">
        {items.map((photo, index) => (
          <div class="photo-description text-center" hidden={index !== 0}>
            <span>{photo.description}</span>
            {photo.link && (
              <a href={photo.link.url} class="intro-link">
                {photo.link.label}
              </a>
            )}
          </div>
        ))}
      </div>

      {/* {total > 1 && <p class="photo-hint">Swipe or use the arrows to explore</p>} */}
    </section>
  )
}

<script>
  import { play } from "cuelume";

  const carousel = document.querySelector<HTMLElement>(".photo-carousel");

  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>(".photo-slide"));
    const descriptions = Array.from(
      carousel.querySelectorAll<HTMLElement>(".photo-description"),
    );
    const stack = carousel.querySelector<HTMLElement>(".photo-stack")!;
    const count = carousel.querySelector<HTMLElement>(".photo-count");
    let current = 0;

    // Must match VISIBLE_DEPTH in the frontmatter.
    const VISIBLE_DEPTH = 4;

    function hydrate(slide: HTMLElement) {
      const picture = slide.querySelector<HTMLElement>("picture[data-deferred]");
      if (!picture) return;
      picture.removeAttribute("data-deferred");
      picture.querySelectorAll<HTMLSourceElement | HTMLImageElement>("[data-srcset]").forEach((el) => {
        el.srcset = el.dataset.srcset!;
        el.removeAttribute("data-srcset");
      });
      const img = picture.querySelector("img");
      if (img?.dataset.src) {
        img.src = img.dataset.src;
        img.removeAttribute("data-src");
      }
    }

    // Warm the buried cards once the page is idle — unless the visitor is on
    // Data Saver or a 2G-class link, where they load only as they're reached.
    const connection = (navigator as Navigator & {
      connection?: { saveData?: boolean; effectiveType?: string };
    }).connection;
    const constrained =
      connection?.saveData || /(^|-)2g$/.test(connection?.effectiveType ?? "");

    if (!constrained) {
      const warm = () => slides.forEach(hydrate);
      const idle = () =>
        "requestIdleCallback" in window
          ? requestIdleCallback(warm, { timeout: 4000 })
          : setTimeout(warm, 1500);
      if (document.readyState === "complete") idle();
      else window.addEventListener("load", idle, { once: true });
    }

    function showPhoto(index: number) {
      current = (index + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        const position = (i - current + slides.length) % slides.length;
        if (position < VISIBLE_DEPTH) hydrate(slide);
        slide.dataset.position = String(position);
        slide.setAttribute("aria-hidden", position === 0 ? "false" : "true");
        slide.inert = position !== 0;
      });

      descriptions.forEach((description, i) => {
        description.hidden = i !== current;
      });

      if (count) count.textContent = `${current + 1} / ${slides.length}`;
    }

    function step(delta: number) {
      if (slides.length < 2) return;
      showPhoto(current + delta);
      play("whisper");
    }

    carousel
      .querySelector("[data-photo-prev]")
      ?.addEventListener("click", () => step(-1));
    carousel
      .querySelector("[data-photo-next]")
      ?.addEventListener("click", () => step(1));

    carousel.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
      event.preventDefault();
      step(event.key === "ArrowRight" ? 1 : -1);
    });

    // Horizontal swipe; vertical drags fall through to page scroll (touch-action: pan-y).
    let start: { x: number; y: number; id: number } | null = null;

    stack.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "mouse" && event.button !== 0) return;
      start = { x: event.clientX, y: event.clientY, id: event.pointerId };
    });

    stack.addEventListener("pointermove", (event) => {
      if (!start || event.pointerId !== start.id) return;
      const dx = Math.abs(event.clientX - start.x);
      const dy = Math.abs(event.clientY - start.y);
      if (dx > 45 && dx > dy) stack.setPointerCapture(event.pointerId);
    });

    stack.addEventListener("pointerup", (event) => {
      if (!start || event.pointerId !== start.id) return;
      const dx = event.clientX - start.x;
      const dy = event.clientY - start.y;
      start = null;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) {
        step(dx < 0 ? 1 : -1);
      }
    });

    stack.addEventListener("pointercancel", () => {
      start = null;
    });
  }
</script>

<style>
  .photo-carousel {
    --polaroid-bg: #f8f8f5;
    --polaroid-border: #e7e7e2;
    --polaroid-ink: #111827;
    --polaroid-shadow: 0 12px 28px rgb(26 26 26 / 0.09), 0 2px 5px rgb(26 26 26 / 0.04);
    --photo-matte: #ecece8;
    --arrow-border: #d1d5db;
    --arrow-hover-bg: #f3f4f6;
    --muted: #6b7280;
    --ease: cubic-bezier(0.23, 1, 0.32, 1);

    width: min(300px, 74vw);
    margin-inline: auto;
    outline-offset: 8px;
  }

  :global(.dark) .photo-carousel {
    --polaroid-bg: #ecebe6;
    --polaroid-border: #d6d5cf;
    --polaroid-shadow: 0 14px 32px rgb(0 0 0 / 0.5), 0 2px 6px rgb(0 0 0 / 0.35);
    --arrow-border: #374151;
    --arrow-hover-bg: #1f2937;
    --muted: #9ca3af;
  }

  .photo-stack {
    position: relative;
    display: grid;
    /* Room for the cards fanned up behind the front one */
    padding-top: 18px;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
  }

  .photo-stack:active {
    cursor: grabbing;
  }

  .photo-slide {
    grid-area: 1 / 1;
    margin: 0;
    padding: 14px 14px 10px;
    background: var(--polaroid-bg);
    border: 1px solid var(--polaroid-border);
    box-shadow: var(--polaroid-shadow);
    /* Default: buried at the back (positions 4+) */
    transform: translate(5px, -18px) rotate(1deg);
    z-index: 1;
    pointer-events: none;
    transition:
      transform 350ms var(--ease),
      opacity 250ms var(--ease);
  }

  .photo-slide[data-position="0"] {
    transform: translate(0, 0) rotate(-2deg);
    z-index: 6;
    pointer-events: auto;
  }

  .photo-slide[data-position="1"] {
    transform: translate(13px, -8px) rotate(4deg);
    z-index: 5;
  }

  .photo-slide[data-position="2"] {
    transform: translate(-12px, -13px) rotate(-7deg);
    z-index: 4;
  }

  .photo-slide[data-position="3"] {
    transform: translate(5px, -18px) rotate(1deg);
    z-index: 3;
  }

  .photo-frame {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--photo-matte);
  }

  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo-slide figcaption {
    height: 3rem;
    margin-top: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "Permanent Marker", "Marker Felt", cursive;
    font-size: 1rem;
    line-height: 1.35;
    color: var(--polaroid-ink);
    text-align: center;
  }

  .photo-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .photo-arrow {
    width: 44px;
    height: 44px;
    border: 1px solid var(--arrow-border);
    border-radius: 50%;
    background: transparent;
    font-size: 1.2rem;
    cursor: pointer;
    transition:
      background-color 150ms ease,
      border-color 150ms ease,
      transform 160ms var(--ease);
  }

  .photo-arrow:active {
    transform: scale(0.95);
  }

  @media (hover: hover) and (pointer: fine) {
    .photo-arrow:hover {
      background: var(--arrow-hover-bg);
      border-color: currentColor;
    }
  }

  .photo-count {
    min-width: 3.5rem;
    text-align: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875rem;
  }

  .photo-descriptions {
    margin-top: 1rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--muted);
  }

  .photo-description[hidden] {
    display: none;
  }

  .photo-description a {
    display: block;
    width: fit-content;
    margin-top: 0.5rem;
  }

  .photo-hint {
    margin-top: 0.5rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-slide,
    .photo-arrow {
      transition: none;
    }
  }
</style>
